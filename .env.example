# =============================================================================
# PrismApp — Environment Variables
# =============================================================================
#
# HOW TO USE:
#   Copy this file to .env and fill in the real values.
#
#   Windows PowerShell:   Copy-Item .env.example .env
#   macOS / Linux:        cp .env.example .env
#
# IMPORTANT:
#   .env is gitignored. Never commit it. This file (.env.example) is the
#   safe, committed template — it contains only placeholders, never secrets.
#
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection URL used by Prisma and the seed script.
#
# Option A — Local PostgreSQL:
#   postgres://postgres:YOUR_PASSWORD@localhost:5432/prismapp?sslmode=disable
#
#   You must create the database first:
#     psql -U postgres -c "CREATE DATABASE prismapp;"
#   or:
#     createdb -U postgres prismapp
#
#   Use sslmode=disable for local PostgreSQL (TLS not enabled by default).
#   Do NOT use sslmode=disable in production.
#
# Option B — Neon (cloud PostgreSQL):
#   In your Neon project dashboard:
#     1. Click Connection Details
#     2. Select "Prisma" from the connection string dropdown
#     3. Copy the URL — it ends with ?sslmode=verify-full
#
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable"


# =============================================================================
# AUTHENTICATION (next-auth)
# =============================================================================

# Secret used to sign and encrypt session tokens. Generate a secure value:
#
#   macOS / Linux:
#     openssl rand -base64 32
#
#   Windows PowerShell:
#     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#
# IMPORTANT: Generate a fresh secret for every project. Never reuse a value
# from a tutorial, a blog post, or another project.
#
AUTH_SECRET="replace-with-a-generated-secret"

# The canonical base URL of the app. next-auth uses this for callback URLs
# and CSRF protection.
#
# Local development: http://localhost:3000 (default Next.js dev port).
# Production: set AUTH_TRUST_HOST=true in Vercel env vars instead so next-auth
# infers the URL from Vercel's request headers automatically.
# See course/H-deployment/vercel.md for details.
#
NEXTAUTH_URL="http://localhost:3000"


# =============================================================================
# SEED DATA
# =============================================================================

# Password used for all seeded demo accounts (admin@example.com, etc.).
# Defaults to ChangeMe123! if this variable is not set.
# Safe for local development; change it for any shared environment.
#
AUTH_SEED_PASSWORD="ChangeMe123!"


# =============================================================================
# OAUTH PROVIDERS (optional — app works without these)
# =============================================================================

# Leave these lines commented out unless you are setting up OAuth sign-in.
# The app automatically enables a provider when both its variables are present.

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000/api/auth/callback/google as an Authorised redirect URI.
#
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft / Azure AD OAuth
# Get credentials from: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Add http://localhost:3000/api/auth/callback/azure-ad as a Redirect URI.
# Omit AZURE_AD_TENANT_ID for a multi-tenant application.
#
# AZURE_AD_CLIENT_ID="your-azure-ad-client-id"
# AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
# AZURE_AD_TENANT_ID="your-tenant-id"


# =============================================================================
# ERROR TRACKING — SENTRY (optional for local dev)
# =============================================================================

# Public DSN — safe to expose in the browser bundle. Used at runtime to send
# captured errors to Sentry. Leave empty to disable error tracking locally.
# Get from: Sentry project → Settings → Client Keys (DSN).
#
# NEXT_PUBLIC_SENTRY_DSN="https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX"

# Build-time variables — used during `next build` to upload source maps to
# Sentry so stack traces show original TypeScript source instead of minified JS.
# Only needed on Vercel (or in CI). Leave unset locally.
#
# SENTRY_AUTH_TOKEN="sntrys_..."   # Sentry → Settings → Auth Tokens → Create
# SENTRY_ORG="your-sentry-org"    # Your Sentry organisation slug
# SENTRY_PROJECT="prismapp"       # Your Sentry project slug