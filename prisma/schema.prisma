generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Block {
  id          String   @id @default(uuid())
  description String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units Unit[]

  @@map("blocks")
}

model Unit {
  id          String   @id @default(uuid())
  description String
  blockId     String
  sqFt        Int
  inceptionDt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  block         Block                 @relation(fields: [blockId], references: [id], onDelete: Restrict)
  owners        UnitOwner[]
  residents     UnitResident[]
  contributions Contribution[]
  complaints    Complaint[]

  @@unique([blockId, description])
  @@index([blockId])
  @@map("units")
}

model GenderType {
  id          Int      @id
  description String   @unique
  createdAt   DateTime @default(now())

  individuals Individual[]

  @@map("gender_types")
}

model Individual {
  id               String   @id @default(uuid())
  fName            String
  mName            String?
  sName            String
  eMail            String   @unique
  mobile           String   @unique
  altMobile        String?
  genderId         Int
  isSystemIdentity Boolean  @default(false)
  systemTag        String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  genderType         GenderType        @relation(fields: [genderId], references: [id], onDelete: Restrict)
  ownedUnits         UnitOwner[]
  livedUnits         UnitResident[]
  contributions      Contribution[]    @relation("ContributionDepositedBy")
  reportedComplaints Complaint[]       @relation("ComplaintReporter")
  assignedComplaints Complaint[]       @relation("ComplaintAssignee")

  @@index([sName, fName])
  @@map("individuals")
}

model AppUser {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@map("app_users")
}

model UnitOwner {
  id        String    @id @default(uuid())
  unitId    String
  indId     String
  fromDt    DateTime
  toDt      DateTime?
  createdAt DateTime  @default(now())

  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  individual Individual @relation(fields: [indId], references: [id], onDelete: Restrict)

  @@index([unitId, fromDt, toDt])
  @@index([indId, fromDt, toDt])
  @@map("unit_owners")
}

model UnitResident {
  id        String    @id @default(uuid())
  unitId    String
  indId     String
  fromDt    DateTime
  toDt      DateTime?
  createdAt DateTime  @default(now())

  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  individual Individual @relation(fields: [indId], references: [id], onDelete: Restrict)

  @@index([unitId, fromDt, toDt])
  @@index([indId, fromDt, toDt])
  @@map("unit_residents")
}

model ContributionHead {
  id          Int      @id @default(autoincrement())
  description String   @unique
  payUnit     Int
  period      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rates         ContributionRate[]
  contributions Contribution[]

  @@map("contribution_heads")
}

model ContributionRate {
  id                 Int       @id @default(autoincrement())
  contributionHeadId Int
  reference          String?
  fromDt             DateTime
  toDt               DateTime?
  amt                Decimal   @db.Decimal(12, 2)
  createdAt          DateTime  @default(now())

  contributionHead ContributionHead @relation(fields: [contributionHeadId], references: [id], onDelete: Restrict)
  details          ContributionDetail[]

  @@index([contributionHeadId, fromDt, toDt])
  @@map("contribution_rates")
}

model ContributionPeriod {
  id        Int      @id @default(autoincrement())
  refMonth  Int
  refYear   Int
  createdAt DateTime @default(now())

  details ContributionDetail[]

  @@unique([refYear, refMonth])
  @@index([refYear])
  @@map("contribution_periods")
}

/// correctionStatus is only set on rows that are themselves corrections (correctionOfContributionId IS NOT NULL).
/// POSTED = live and counted in reports (default for all existing corrections and new single-step corrections).
/// PENDING = submitted but awaiting a second approver (maker-checker, future activation).
/// REJECTED = declined by checker; not counted in reports; original is free to be corrected again.
model Contribution {
  id                         Int      @id @default(autoincrement())
  unitId                     String
  contributionHeadId         Int
  quantity                   Int
  periodCount                Int
  transactionId              String
  transactionDateTime        DateTime
  depositedBy                String
  inputComment               String?
  actorUserId                String?
  actorRole                  String?
  correctionOfContributionId Int?
  correctionReasonCode       String?
  correctionReasonText       String?
  correctionStatus           String?  // POSTED | PENDING | REJECTED — null on non-correction rows
  correctionApprovedById     String?  // actorUserId of the checker who approved
  correctionApprovedAt       DateTime?
  correctionRejectedById     String?  // actorUserId of the checker who rejected
  correctionRejectedAt       DateTime?
  correctionRejectionReason  String?
  createdAt                  DateTime @default(now())

  unit              Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  contributionHead  ContributionHead  @relation(fields: [contributionHeadId], references: [id], onDelete: Restrict)
  depositor         Individual        @relation("ContributionDepositedBy", fields: [depositedBy], references: [id], onDelete: Restrict)
  correctionOf      Contribution?     @relation("ContributionCorrection", fields: [correctionOfContributionId], references: [id], onDelete: Restrict)
  correctedBy       Contribution[]    @relation("ContributionCorrection")
  details           ContributionDetail[]

  @@index([unitId, contributionHeadId])
  @@index([contributionHeadId])
  @@index([transactionDateTime])
  @@index([depositedBy])
  @@index([correctionOfContributionId])
  @@map("contributions")
}

model ContributionDetail {
  id                   Int      @id @default(autoincrement())
  contributionId       Int
  contributionPeriodId Int
  contributionRateId   Int?
  amt                  Decimal  @db.Decimal(12, 2)
  appliedRate          Decimal? @db.Decimal(12, 4)
  appliedRateReference String?
  createdAt            DateTime @default(now())

  contribution       Contribution     @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  contributionPeriod ContributionPeriod @relation(fields: [contributionPeriodId], references: [id], onDelete: Restrict)
  contributionRate   ContributionRate? @relation(fields: [contributionRateId], references: [id], onDelete: Restrict)

  @@unique([contributionId, contributionPeriodId])
  @@index([contributionPeriodId])
  @@index([contributionRateId])
  @@map("contribution_details")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actorRole   String
  action      String
  entityType  String
  entityId    String
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// CMM — Complaint Management Module
// ---------------------------------------------------------------------------

model ComplaintCategory {
  id          Int    @id @default(autoincrement())
  description String @unique

  complaints Complaint[]

  @@map("complaint_categories")
}

model ComplaintPriority {
  id          Int    @id @default(autoincrement())
  label       String @unique // P1 | P2 | P3
  slaHours    Int
  description String

  complaints Complaint[]

  @@map("complaint_priorities")
}

/// status: Open | Assigned | InProgress | Resolved | Closed | Reopened
/// Immutable after creation: ticketId, unitId, reportedById, isAnonymous, createdAt (CM17)
/// ticketId is service-generated in the format MSH-{year}-{zero-padded-seq} (CM6, CM7)
model Complaint {
  id             String    @id @default(uuid())
  ticketId       String    @unique
  unitId         String
  reportedById   String
  categoryId     Int
  priorityId     Int
  title          String
  description    String
  isAnonymous    Boolean   @default(false)
  status         String    @default("Open") // Open | Assigned | InProgress | Resolved | Closed | Reopened
  assignedToId   String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  reopenDeadline DateTime? // resolvedAt + 48h; cleared when Closed (CM3)
  actorUserId    String?   // AppUser.id of operator who created the record
  actorRole      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  unit     Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  reporter Individual        @relation("ComplaintReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  category ComplaintCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priority ComplaintPriority @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  assignee Individual?       @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  notes    ComplaintNote[]

  @@index([unitId])
  @@index([status])
  @@index([categoryId])
  @@index([priorityId])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("complaints")
}

/// visibility: Internal | Resident
/// Append-only — no update or delete permitted (CM16)
/// authorId uses AppUser.id (actorUserId) to match V1 operator actor model
model ComplaintNote {
  id          String   @id @default(uuid())
  complaintId String
  content     String
  visibility  String   // Internal | Resident
  actorUserId String   // AppUser.id of the operator who wrote the note
  actorRole   String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)

  @@index([complaintId])
  @@map("complaint_notes")
}
